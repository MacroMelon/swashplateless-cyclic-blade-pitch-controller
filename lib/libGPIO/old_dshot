void DshotStartWrite(uint16_t throttle)
{
	//pg 374 of ref manual
    /*
	 * Right, so for DShot, we want DShot1200 because why not.
	 * SO Thats 1,200,000 Dshot-bits/sec (1.2Mhz). -> timer + counter frequency
     * count to 8? check with divisors n stuff
     *
     * so heres the plan:
     * have a flag to set when writing to halt processor, clear when done and proceed
     * use __wfi() (wait for interrupt)
     * set timer ARR to bit length
     * have a counter to keep track of bit number (maybe TIMx_RCR (repetition counter?)
     * update event interrupt load next CCR1 vlaue (preload eneabled so it should work)
     * on every interrupt:
     * set CCR to appropriate value based on bit number counter
     * if counter = 16, next bit zero, CCRx to zero, disable CEN?
     * TODO - use DMA for all this

	 As the preload registers are transferred to the shadow registers only when an update event
	occurs, before starting the counter, you have to initialize all the registers by setting the UG
	bit in the TIMx_EGR register
	*/
	Dshot_preparePacketData(Dshot_build_packet(throttle));

	if (transferDone == 1){
		transferDone = 0;					//starting tranfer, set flag
		//double buffered, incase tranfser is ongoing while we prepare packet
		memcpy(&scary_packet_data, &safe_packet_data, 16);	//no need last byte, always zero

		//blank frames to send signal low for a while in continous mode
		//TODO- set blank frames once and forget
		scary_packet_data[16] = 0;
		scary_packet_data[17] = 0;
		scary_packet_data[18] = 0;
		counter = 0;
		TIM3->CCR1 = scary_packet_data[counter];	//write first thingy to CCR
		counter++;
		TIM3->CR1 &= ~(TIM_CR1_UDIS);		//begin update events
	}
}

void TIM3_IRQHandler (void)
{
	//TODO- maybe get rid of CCR2 and update everything using CCR1... yeah with DMA no need extra timing
	if (TIM3->SR & TIM_SR_UIF){
		if (counter <= 16){				//data + 2 zero bits
			//load CCR1 value for next bit
			TIM3->CCR1 = safe_packet_data[counter];
			counter++;
		}
		else{
			//TIM3->CCR1 = 0;							//send the pin low
			//TIM3->CR1 |= TIM_CR1_UDIS;				//halt update event interrupts
			//transferDone = 1;
			TIM3->CR1 |= TIM_CR1_UDIS;				//halt update event interrupts
			counter = 0;
			//todo- this is a bit mad
			Dshot_preparePacketData(Dshot_build_packet(esc_value));
			TIM3->CR1 &= ~(TIM_CR1_UDIS);		//begin update events
		}
		TIM3->SR &= ~(TIM_SR_UIF);	//clear flag
	}
}

